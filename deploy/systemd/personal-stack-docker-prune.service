[Unit]
Description=Personal Stack safe Docker prune
After=docker.service

[Service]
Type=oneshot
User=agent
Group=agent
WorkingDirectory=/opt/personal-stack
Environment=DOCKER_PRUNE_BUILD_CACHE_H=168
Environment=DOCKER_PRUNE_RESERVED_SPACE=2GB
ExecStart=/bin/bash /opt/personal-stack/scripts/docker-prune-safe.sh

[Install]
WantedBy=multi-user.target
