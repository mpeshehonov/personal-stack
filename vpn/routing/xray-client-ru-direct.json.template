{
  "log": { "loglevel": "warning" },
  "dns": {
    "servers": [
      {
        "address": "77.88.8.8",
        "domains": ["geosite:category-ru-all", "domain:ru", "domain:su", "domain:xn--p1ai"],
        "skipFallback": true
      },
      "1.1.1.1"
    ]
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10888,
      "protocol": "socks",
      "settings": { "udp": true },
      "tag": "socks-in"
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "tag": "proxy",
      "settings": {
        "vnext": [
          {
            "address": "SERVER_IP",
            "port": 2053,
            "users": [
              {
                "id": "UUID",
                "encryption": "none",
                "flow": ""
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "yandex.ru",
          "fingerprint": "chrome",
          "publicKey": "REALITY_PUBLIC_KEY",
          "shortId": "SHORT_ID"
        }
      }
    },
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": { "domainStrategy": "UseIPv4" }
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "outboundTag": "direct",
        "domain": [
          "geosite:category-ru-all",
          "domain:ru",
          "domain:su",
          "domain:xn--p1ai",
          "domain:moscow"
        ]
      },
      {
        "type": "field",
        "outboundTag": "direct",
        "ip": ["geoip:ru", "geoip:private"]
      },
      {
        "type": "field",
        "outboundTag": "proxy",
        "network": "tcp,udp"
      }
    ]
  },
  "remarks": "Import geosite/geoip from ru-routing-dat — see vpn/routing/README.md"
}
