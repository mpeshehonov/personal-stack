# Job hunt autopilot — read-only scan + digest (Phase 0)
# Copy to secrets/.env.jobhunt and chmod 600

JOBHUNT_ENABLED=true
JOBHUNT_HH_TEXT="frontend react typescript"
# Несколько запросов через запятую (dedup по id)
JOBHUNT_HH_QUERIES="senior frontend react typescript,next.js frontend remote,frontend react e-commerce"
JOBHUNT_MIN_MATCH=55
JOBHUNT_MIN_SALARY_RUB=250000
JOBHUNT_USER_AGENT="personal-stack-agent/1.0 (kassady71@gmail.com)"

# HH.ru search defaults (area 113 = Russia)
# api.hh.ru often returns 403 from NL VPS (ddos-guard) — Habr Career used as fallback
JOBHUNT_HH_ENABLED=true
JOBHUNT_HH_AREA=113
JOBHUNT_HH_PER_PAGE=20
JOBHUNT_HH_MAX_PAGES=2

JOBHUNT_HABR_ENABLED=true
JOBHUNT_HABR_QUERY="frontend react typescript"

# Hirify — агрегатор TG + career sites (api.hirify.me)
JOBHUNT_HIRIFY_ENABLED=true
JOBHUNT_HIRIFY_QUERY="frontend react typescript"
JOBHUNT_HIRIFY_QUERIES="senior frontend react typescript,next.js frontend remote"
JOBHUNT_HIRIFY_MAX_PAGES=2

# HireHi — RF job board (hirehi.ru)
JOBHUNT_HIREHI_ENABLED=true
JOBHUNT_HIREHI_SUBCATEGORIES="frontend,fullstack"
JOBHUNT_HIREHI_MAX_PAGES=2
JOBHUNT_HIREHI_LIMIT=50

# Telegram public channels (t.me/s/ preview, read-only)
JOBHUNT_TG_ENABLED=true
JOBHUNT_TG_CHANNELS="frontend_rabota,job_react,proglib_jobs"
JOBHUNT_TG_KEYWORDS="frontend,front-end,react,typescript,next.js,nextjs,javascript,fullstack,full-stack,фронтенд,фронт"
