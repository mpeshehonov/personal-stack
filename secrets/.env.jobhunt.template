# Job hunt autopilot — read-only scan + digest (Phase 0)
# Copy to secrets/.env.jobhunt and chmod 600

JOBHUNT_ENABLED=true
JOBHUNT_HH_TEXT="frontend react typescript"
JOBHUNT_MIN_MATCH=55
JOBHUNT_MIN_SALARY_RUB=250000
JOBHUNT_USER_AGENT="personal-stack-agent/1.0 (kassady71@gmail.com)"

# HH.ru search defaults (area 113 = Russia)
# api.hh.ru often returns 403 from NL VPS (ddos-guard) — Habr Career used as fallback
JOBHUNT_HH_ENABLED=true
JOBHUNT_HH_AREA=113
JOBHUNT_HH_PER_PAGE=20
JOBHUNT_HH_MAX_PAGES=2

JOBHUNT_HABR_ENABLED=true
JOBHUNT_HABR_QUERY="frontend react typescript"
