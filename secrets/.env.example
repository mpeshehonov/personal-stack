# Copy to secrets/.env.cursor, secrets/.env.telegram, secrets/.env.finance
# chmod 600 each file

# --- .env.cursor ---
# CURSOR_API_KEY=cursor_...

# --- .env.telegram ---
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALLOWED_USER_IDS=123456789

# --- .env.finance ---
# FINANCE_LIVE=false
# MAX_TRADE_USD=75
# DAILY_STOP_LOSS_USD=100
# MAX_OPEN_POSITIONS=3
# YOUR_WALLET_ADDRESS=0x...
# OPERATIONAL_WALLET_PRIVATE_KEY=  # only when live; prefer encrypted storage
# POLYGON_RPC_URL=https://polygon-rpc.com
# POLYMARKET_API_KEY=
