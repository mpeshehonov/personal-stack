# Copy to secrets/.env.checkout and chmod 600
# Mount via docker-compose env_file on site service

# Required: HMAC secret for delivery download tokens (openssl rand -hex 32)
CHECKOUT_DELIVERY_SECRET=

# NOWPayments (primary) — https://account.nowpayments.io/
# IPN callback URL: https://mpeshekhonov.ru/api/checkout/ipn
NOWPAYMENTS_IPN_SECRET=
# Optional: for programmatic invoice creation (future /api/checkout/create)
NOWPAYMENTS_API_KEY=

# Cryptomus (alternative) — https://cryptomus.com/
# Webhook URL: https://mpeshekhonov.ru/api/checkout/ipn?provider=cryptomus
CRYPTOMUS_API_KEY=
CRYPTOMUS_MERCHANT_ID=

# Public base URL for delivery links in IPN responses
CHECKOUT_PUBLIC_BASE_URL=https://mpeshekhonov.ru

# Bundle file inside site container (mount ./dist → /app/delivery)
A4_BUNDLE_PATH=/app/delivery/personal-stack-agent-starter-v0.3.tar.gz

# Pricing (USD list; buyer pays USDT equivalent)
A4_INTRO_PRICE_USD=19
A4_REGULAR_PRICE_USD=29
CHECKOUT_FEE_RATE=0.01
CHECKOUT_DELIVERY_TTL_DAYS=7

# Order persistence (shared with agent checkout_sync.py)
CHECKOUT_DATA_DIR=/app/data/checkout
CHECKOUT_ORDERS_PATH=/app/data/checkout/orders.json
